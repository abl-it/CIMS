@model AssessmentQuestionListViewModel
@{
    ViewData["Title"] = "Environment Assessment";
    var result = Model.Result;
    var currentUrl = Context.Request.Path + Context.Request.QueryString;

    // Route values untuk link sort/paging; semua filter ikut terbawa.
    Dictionary<string, string?> RouteFor(int page, string? sortBy = null, string? sortDir = null)
    {
        var d = new Dictionary<string, string?>
        {
            ["sortBy"] = sortBy ?? Model.SortBy,
            ["sortDir"] = sortDir ?? Model.SortDir,
            ["page"] = page.ToString(),
            ["pageSize"] = Model.PageSize.ToString()
        };
        if (!string.IsNullOrWhiteSpace(Model.Search)) d["search"] = Model.Search;
        if (Model.IsActive.HasValue) d["isActive"] = Model.IsActive.Value.ToString().ToLowerInvariant();
        return d;
    }

    Dictionary<string, string?> SortRoute(string column)
    {
        var dir = Model.SortBy == column && Model.SortDir == "ASC" ? "DESC" : "ASC";
        return RouteFor(1, column, dir);
    }

    string SortMark(string column) =>
        Model.SortBy == column ? (Model.SortDir == "ASC" ? " ▲" : " ▼") : "";

    var firstItem = result.TotalCount == 0 ? 0 : (result.PageNumber - 1) * result.PageSize + 1;
    var lastItem = Math.Min(result.PageNumber * result.PageSize, result.TotalCount);
    var pageStart = Math.Max(1, result.PageNumber - 2);
    var pageEnd = Math.Min(result.TotalPages, result.PageNumber + 2);
}

<div class="cims-page-header d-grid d-md-flex justify-content-md-between align-items-md-center gap-2">
    <h1 class="h3 mb-0">Environment Assessment</h1>
    <a asp-action="Create" asp-route-returnUrl="@currentUrl" class="btn btn-primary btn-lg"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Question</a>
</div>

<form asp-action="Index" method="get" class="cims-filter row g-2">
    <input type="hidden" name="sortBy" value="@Model.SortBy" />
    <input type="hidden" name="sortDir" value="@Model.SortDir" />
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <div class="col-12 col-md">
        <label for="search" class="form-label visually-hidden">Search</label>
        <input type="search" id="search" name="search" value="@Model.Search" class="form-control" placeholder="Search question" />
    </div>
    <div class="col-12 col-md-auto">
        <label for="isActive" class="form-label visually-hidden">Status</label>
        <select id="isActive" name="isActive" class="form-select">
            <option value="" selected="@(!Model.IsActive.HasValue)">All statuses</option>
            <option value="true" selected="@(Model.IsActive == true)">Active</option>
            <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
        </select>
    </div>
    <div class="col-12 col-md-auto d-grid d-md-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1" aria-hidden="true"></i>Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Reset</a>
    </div>
</form>

@if (!result.Items.Any())
{
    <div class="alert alert-info" role="status">No questions found.</div>
}
else
{
    @* Desktop / tablet: tabel *@
    <div class="d-none d-md-block">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="cims-col-fit"><a class="sort-link" asp-action="Index" asp-all-route-data='SortRoute("SortOrder")'>Order@(SortMark("SortOrder"))</a></th>
                        <th><a class="sort-link" asp-action="Index" asp-all-route-data='SortRoute("QuestionText")'>Question@(SortMark("QuestionText"))</a></th>
                        <th class="cims-col-fit">Status</th>
                        <th class="cims-col-fit text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in result.Items)
                    {
                        <tr>
                            <td class="cims-col-fit">@q.SortOrder</td>
                            <td>@q.QuestionText</td>
                            <td class="cims-col-fit">
                                @if (q.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="cims-col-fit text-end">
                              <div class="d-inline-flex gap-1">
                                <a asp-action="Details" asp-route-id="@q.Id" asp-route-returnUrl="@currentUrl" class="btn btn-outline-secondary cims-icon-btn"
                                   title="View details" aria-label="View details of question @q.SortOrder"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                <a asp-action="Edit" asp-route-id="@q.Id" asp-route-returnUrl="@currentUrl" class="btn btn-outline-primary cims-icon-btn"
                                   title="Edit" aria-label="Edit question @q.SortOrder"><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
                                <form asp-action="SetActive" method="post" class="d-inline"
                                      data-confirm="@(q.IsActive ? "Deactivate this question?" : "Activate this question?")"
                                      data-confirm-title="@(q.IsActive ? "Deactivate Question" : "Activate Question")"
                                      data-confirm-ok="@(q.IsActive ? "Deactivate" : "Activate")"
                                      data-confirm-danger="@(q.IsActive ? "true" : null)">
                                    <input type="hidden" name="id" value="@q.Id" />
                                    <input type="hidden" name="isActive" value="@((!q.IsActive).ToString().ToLowerInvariant())" />
                                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                                    <button type="submit" class="btn cims-icon-btn @(q.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                            title="@(q.IsActive ? "Deactivate" : "Activate")"
                                            aria-label="@(q.IsActive ? "Deactivate" : "Activate") question @q.SortOrder">
                                        <i class="bi @(q.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i>
                                    </button>
                                </form>
                              </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Mobile: card list *@
    <div class="d-md-none">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted">Sort by:</span>
            <div class="btn-group" role="group" aria-label="Sort">
                <a class="btn btn-outline-secondary @(Model.SortBy == "SortOrder" ? "active" : "")" asp-action="Index" asp-all-route-data='SortRoute("SortOrder")'>Order@(SortMark("SortOrder"))</a>
                <a class="btn btn-outline-secondary @(Model.SortBy == "QuestionText" ? "active" : "")" asp-action="Index" asp-all-route-data='SortRoute("QuestionText")'>Question@(SortMark("QuestionText"))</a>
            </div>
        </div>
        @foreach (var q in result.Items)
        {
            <div class="card assessment-card mb-2">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="assessment-text">
                            <div class="text-muted small">Order @q.SortOrder</div>
                            <div class="fw-semibold">@q.QuestionText</div>
                        </div>
                        @if (q.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                    </div>
                    <div class="d-grid gap-2 mt-3">
                        <div class="row g-2">
                            <div class="col-6"><a asp-action="Details" asp-route-id="@q.Id" asp-route-returnUrl="@currentUrl" class="btn btn-outline-secondary w-100">Details</a></div>
                            <div class="col-6"><a asp-action="Edit" asp-route-id="@q.Id" asp-route-returnUrl="@currentUrl" class="btn btn-outline-primary w-100">Edit</a></div>
                        </div>
                        <form asp-action="SetActive" method="post" class="d-grid"
                              data-confirm="@(q.IsActive ? "Deactivate this question?" : "Activate this question?")"
                              data-confirm-title="@(q.IsActive ? "Deactivate Question" : "Activate Question")"
                              data-confirm-ok="@(q.IsActive ? "Deactivate" : "Activate")"
                              data-confirm-danger="@(q.IsActive ? "true" : null)">
                            <input type="hidden" name="id" value="@q.Id" />
                            <input type="hidden" name="isActive" value="@((!q.IsActive).ToString().ToLowerInvariant())" />
                            <input type="hidden" name="returnUrl" value="@currentUrl" />
                            <button type="submit" class="btn @(q.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                @(q.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="cims-list-footer d-flex flex-column flex-md-row justify-content-md-between align-items-md-center gap-2">
        <div class="text-muted small">Showing @firstItem–@lastItem of @result.TotalCount</div>
        @if (result.TotalPages > 1)
        {
            <nav aria-label="Pagination">
                <ul class="pagination pagination-sm mb-0 flex-wrap">
                    <li class="page-item @(result.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="RouteFor(result.PageNumber - 1)">Previous</a>
                    </li>
                    @for (var p = pageStart; p <= pageEnd; p++)
                    {
                        <li class="page-item @(p == result.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-all-route-data="RouteFor(p)">@p</a>
                        </li>
                    }
                    <li class="page-item @(result.PageNumber >= result.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="RouteFor(result.PageNumber + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
