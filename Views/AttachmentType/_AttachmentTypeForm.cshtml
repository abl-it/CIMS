@model AttachmentTypeFormViewModel
@{
    var isEdit = Model.Id > 0;
    var action = isEdit ? "Edit" : "Create";
    var cancelAction = isEdit ? "Details" : "Index";
    // URL list asal (filter, sort, halaman) dari Index; null = alur default.
    var returnUrl = ViewData["ReturnUrl"] as string;
    var cancelUrl = returnUrl ?? Url.Action(cancelAction, new { id = isEdit ? Model.Id : (int?)null });
}

<form id="attachment-type-form" asp-controller="AttachmentType" asp-action="@action" asp-route-id="@(isEdit ? Model.Id : (int?)null)" method="post" novalidate data-dirty-guard>
    <input type="hidden" asp-for="Id" />
    @if (returnUrl != null)
    {
        <input type="hidden" name="returnUrl" value="@returnUrl" />
    }

    <div class="row g-3">
        <div class="col-12 col-md-6 col-lg-4">
            <label asp-for="Code" class="form-label"></label>
            @if (isEdit)
            {
                @* Code tidak bisa diubah setelah dibuat (dipakai modul lain sebagai kunci). *@
                <input asp-for="Code" class="form-control" readonly />
                <div class="form-text">Code cannot be changed.</div>
            }
            else
            {
                <input asp-for="Code" class="form-control text-uppercase" autocomplete="off" placeholder="e.g. SITE_REPORT" />
            }
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6 col-lg-8">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autocomplete="off" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <label asp-for="Stage" class="form-label"></label>
            <select asp-for="Stage" class="form-select">
                <option value="">-- Select stage --</option>
                @foreach (var s in AttachmentType.Stages)
                {
                    <option value="@s.Key" selected="@(Model.Stage == s.Key)">@s.Value</option>
                }
            </select>
            <span asp-validation-for="Stage" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6 col-lg-5">
            <label asp-for="AllowedExtensions" class="form-label"></label>
            <input asp-for="AllowedExtensions" class="form-control" autocomplete="off" placeholder="e.g. pdf,jpg,png" />
            <div class="form-text">Separate with commas, without dots.</div>
            <span asp-validation-for="AllowedExtensions" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <label asp-for="MaxSizeMB" class="form-label"></label>
            <input asp-for="MaxSizeMB" type="number" min="1" max="100" class="form-control" />
            <span asp-validation-for="MaxSizeMB" class="text-danger"></span>
        </div>
        <div class="col-12">
            <fieldset>
                <legend class="form-label">Mandatory for category</legend>
                <div class="d-flex flex-wrap gap-3">
                    <div class="form-check">
                        <input asp-for="IsMandatoryCapex" class="form-check-input" />
                        <label asp-for="IsMandatoryCapex" class="form-check-label">CAPEX</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsMandatoryOpex" class="form-check-input" />
                        <label asp-for="IsMandatoryOpex" class="form-check-label">OPEX</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsMandatoryLve" class="form-check-input" />
                        <label asp-for="IsMandatoryLve" class="form-check-label">LVE</label>
                    </div>
                </div>
                <div class="form-text">The attachment must be uploaded at its stage for the checked categories.</div>
            </fieldset>
        </div>
        <div class="col-12">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" role="switch" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-12">
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <a href="@cancelUrl" class="btn btn-outline-secondary btn-lg"
                   data-confirm="Unsaved changes will be lost." data-confirm-title="Discard changes?"
                   data-confirm-ok="Yes, discard" data-confirm-danger="true" data-confirm-if-dirty="#attachment-type-form">Cancel</a>
                <button type="submit" class="btn btn-primary btn-lg">@(isEdit ? "Save Changes" : "Save")</button>
            </div>
        </div>
    </div>
</form>
