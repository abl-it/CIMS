@model CustomerFormViewModel
@{
    var isEdit = Model.Id > 0;
    var action = isEdit ? "Edit" : "Create";
    var cancelAction = isEdit ? "Details" : "Index";
}

<form id="customer-form" asp-controller="Customer" asp-action="@action" asp-route-id="@(isEdit ? Model.Id : (int?)null)" method="post" novalidate data-dirty-guard>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-12 col-md-6 col-lg-4">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" autocomplete="off" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6 col-lg-8">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autocomplete="off" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" type="tel" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6 col-lg-8">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Address" class="form-label"></label>
            <textarea asp-for="Address" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
        <div class="col-12">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" role="switch" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-12">
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <a asp-action="@cancelAction" asp-route-id="@(isEdit ? Model.Id : (int?)null)" class="btn btn-outline-secondary btn-lg"
                   data-confirm="Perubahan yang belum disimpan akan hilang." data-confirm-title="Batalkan perubahan?"
                   data-confirm-ok="Ya, batalkan" data-confirm-danger="true" data-confirm-if-dirty="#customer-form">Batal</a>
                <button type="submit" class="btn btn-primary btn-lg">@(isEdit ? "Simpan Perubahan" : "Simpan")</button>
            </div>
        </div>
    </div>
</form>
