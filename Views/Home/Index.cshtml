@model HomeIndexViewModel
@using CIMS.Filters
@using CIMS.Services
@inject ICurrentUserService CurrentUserService
@{
    ViewData["Title"] = "Home";
    // Dashboard: semua role CIMS kecuali purchasing (matriks PRD 5.2); otorisasi tetap di DashboardController
    var DashboardRoles = new[] { CimsRoles.Adm, CimsRoles.Plan, CimsRoles.Spv, CimsRoles.Emp, CimsRoles.Kabag, CimsRoles.Mo,
        CimsRoles.Civil, CimsRoles.Fat, CimsRoles.Gm, CimsRoles.Director, CimsRoles.Administrator };
}

<h1 class="h3 mb-3">Home</h1>

@* Shortcut Tugas Saya (FR-01): jumlah per jenis + link langsung *@
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center gap-2">
        <span class="fw-semibold"><i class="bi bi-bell me-1" aria-hidden="true"></i>My Tasks</span>
        <a asp-controller="MyTask" asp-action="Index">View all (@Model.TaskTotal)</a>
    </div>
    <div class="card-body">
        @if (Model.TaskTotal == 0)
        {
            <p class="text-muted mb-0">You have no pending tasks.</p>
        }
        else
        {
            <div class="row g-2">
                @foreach (var s in Model.TaskSummary.Where(s => s.TaskCount > 0))
                {
                    <div class="col-12 col-sm-6 col-lg-4">
                        <a class="card mytask-shortcut h-100" asp-controller="MyTask" asp-action="Index" asp-route-type="@s.TaskType">
                            <div class="card-body d-flex align-items-center gap-3">
                                <i class="bi @UserTaskType.Icon(s.TaskType) mytask-shortcut-icon" aria-hidden="true"></i>
                                <div>
                                    <div class="h4 mb-0">@s.TaskCount</div>
                                    <div class="text-muted small">@UserTaskType.Label(s.TaskType)</div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (CimsRoles.HasAny(CurrentUserService.CurrentUser, DashboardRoles))
{
    <div class="card">
        <div class="card-body d-grid d-md-flex justify-content-md-between align-items-md-center gap-2">
            <div>
                <h2 class="h5 card-title mb-1">Dashboard</h2>
                <p class="card-text text-muted mb-0">Project status per category (CAPEX, OPEX, LVE), cost to date, and the active project list.</p>
            </div>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg"><i class="bi bi-speedometer2 me-1" aria-hidden="true"></i>Open Dashboard</a>
        </div>
    </div>
}
