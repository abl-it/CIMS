@model LocationFormViewModel
@{
    var isEdit = Model.Id > 0;
    var action = isEdit ? "Edit" : "Create";
    var cancelAction = isEdit ? "Details" : "Index";
    // URL list asal (filter, sort, halaman) dari Index; null = alur default.
    var returnUrl = ViewData["ReturnUrl"] as string;
    var cancelUrl = returnUrl ?? Url.Action(cancelAction, new { id = isEdit ? Model.Id : (int?)null });
}

<form id="location-form" asp-controller="Location" asp-action="@action" asp-route-id="@(isEdit ? Model.Id : (int?)null)" method="post" novalidate data-dirty-guard>
    <input type="hidden" asp-for="Id" />
    @if (returnUrl != null)
    {
        <input type="hidden" name="returnUrl" value="@returnUrl" />
    }

    <div class="row g-3">
        <div class="col-12 col-md-6 col-lg-4">
            <label asp-for="CoCode" class="form-label"></label>
            <select asp-for="CoCode" class="form-select">
                <option value="">-- Select company --</option>
                @foreach (var co in LocationFormViewModel.CoCodes)
                {
                    <option value="@co" selected="@(Model.CoCode == co)">@co</option>
                }
            </select>
            <span asp-validation-for="CoCode" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6 col-lg-8">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autocomplete="off" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-12">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" role="switch" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-12">
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <a href="@cancelUrl" class="btn btn-outline-secondary btn-lg"
                   data-confirm="Unsaved changes will be lost." data-confirm-title="Discard changes?"
                   data-confirm-ok="Yes, discard" data-confirm-danger="true" data-confirm-if-dirty="#location-form">Cancel</a>
                <button type="submit" class="btn btn-primary btn-lg">@(isEdit ? "Save Changes" : "Save")</button>
            </div>
        </div>
    </div>
</form>
