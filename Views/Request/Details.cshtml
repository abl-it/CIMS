@model RequestDetailsViewModel
@{
    var r = Model.Request;
    ViewData["Title"] = "Request Details";
    ViewData["ContentWidth"] = "narrow";
    // URL list asal (filter, sort, halaman); null = list tanpa filter.
    var returnUrl = ViewData["ReturnUrl"] as string;
    var backUrl = returnUrl ?? Url.Action("Index");
    var culture = System.Globalization.CultureInfo.InvariantCulture;

    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    string Size(long bytes) => bytes >= 1048576
        ? (bytes / 1048576d).ToString("0.0", culture) + " MB"
        : Math.Max(1, bytes / 1024).ToString(culture) + " KB";

    bool IsMandatory(AttachmentType t) => r.Category switch
    {
        "CAPEX" => t.IsMandatoryCapex,
        "OPEX" => t.IsMandatoryOpex,
        "LVE" => t.IsMandatoryLve,
        _ => false
    };
    var missingMandatory = Model.AttachmentTypes
        .Where(t => IsMandatory(t) && !Model.Attachments.Any(a => a.AttachmentTypeId == t.Id))
        .Select(t => t.Name)
        .ToList();

    // T4-1: TOR (tahap PROCUREMENT) dan lampiran kontrak (tahap CONTRACT)
    var hasTor = Model.Attachments.Any(a => a.Stage == "PROCUREMENT");
    var hasContractAttachment = Model.Attachments.Any(a => a.Stage == "CONTRACT");
    var contract = Model.Contract;
}

<div class="cims-page-header d-grid d-md-flex justify-content-md-between align-items-md-center gap-2">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <h1 class="h3 mb-0">Request Details</h1>
        <span class="badge @RequestStatus.BadgeClass(r.Status)">@RequestStatus.Label(r.Status)</span>
        @if (r.IsMigrated)
        {
            @* Project berjalan saat go-live (FR-03, BR-77) *@
            <span class="badge text-bg-secondary" title="Running project entered by Civil (data migration); approvals were done outside CIMS">Migrated</span>
        }
    </div>
    <div class="d-grid d-md-flex gap-2">
        <a href="@backUrl" class="btn btn-outline-secondary btn-lg"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back</a>
        @if (Model.CanEdit)
        {
            <a asp-action="Edit" asp-route-id="@r.Id" asp-route-returnUrl="@returnUrl" class="btn btn-outline-primary btn-lg"><i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Edit</a>
            @* Submit / Resubmit (FR-04, BR-07); kelengkapan dicek di SP *@
            <form asp-action="Submit" method="post" class="d-grid"
                  data-confirm="@(r.Status == RequestStatus.Returned ? "Resubmit this request for approval?" : "Submit this request for approval? It cannot be edited while waiting for approval.")"
                  data-confirm-title="@(r.Status == RequestStatus.Returned ? "Resubmit Request" : "Submit Request")"
                  data-confirm-ok="Submit">
                <input type="hidden" name="id" value="@r.Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-send me-1" aria-hidden="true"></i>@(r.Status == RequestStatus.Returned ? "Resubmit" : "Submit")</button>
            </form>
        }
    </div>
</div>

@* Approval langkah aktif (T2-3): hanya untuk user yang berhak (fn_User_ActionableSteps); validasi akhir di SP *@
@if (Model.ActionableStep is { } act)
{
    <div class="card mb-3 border-info request-approval">
        <div class="card-header fw-semibold">Your Approval</div>
        <div class="card-body">
            <p class="mb-3">
                @act.PointLabel · step @act.StepOrder: <span class="fw-semibold">@(string.IsNullOrEmpty(act.RoleName) ? act.RoleCode : act.RoleName)</span>
                @if (act.StartedAt.HasValue)
                {
                    <span class="text-muted small">(waiting since @act.StartedAt.Value.ToString("dd MMM yyyy HH:mm", culture))</span>
                }
            </p>
            <form asp-action="ApprovalAct" method="post" id="approvalForm" data-remarks-form>
                <input type="hidden" name="id" value="@r.Id" />
                <input type="hidden" name="stepId" value="@act.Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="mb-3">
                    <label for="approvalRemarks" class="form-label">Remarks</label>
                    <textarea id="approvalRemarks" name="remarks" class="form-control" rows="3" maxlength="1000"
                              aria-describedby="approvalRemarksHelp approvalRemarksError"></textarea>
                    <div id="approvalRemarksHelp" class="form-text">
                        Optional for approval; required for revision or rejection.@(act.ReviseTo == "CIVIL" ? " Revision returns the request to Civil (feasibility)." : "")
                    </div>
                    <div id="approvalRemarksError" class="invalid-feedback">Remarks are required to revise or reject.</div>
                </div>
                <div class="d-grid d-md-flex justify-content-md-end gap-2">
                    @if (act.AllowReject)
                    {
                        <button type="submit" name="approvalAction" value="@ApprovalAction.Reject" class="btn btn-outline-danger btn-lg"
                                data-requires-remarks="true"
                                data-confirm="Reject this request? This is final." data-confirm-title="Reject Request"
                                data-confirm-ok="Reject" data-confirm-danger="true">
                            <i class="bi bi-x-octagon me-1" aria-hidden="true"></i>Reject
                        </button>
                    }
                    @* Tujuan Revise dari snapshot langkah: REQUESTER (T2-3) atau CIVIL / Feasibility (T3-3, BR-06, BR-07) *@
                    @if (act.ReviseTo is "REQUESTER" or "CIVIL")
                    {
                        <button type="submit" name="approvalAction" value="@ApprovalAction.Revise" class="btn btn-outline-warning btn-lg"
                                data-requires-remarks="true"
                                data-confirm="@(act.ReviseTo == "CIVIL" ? "Return this request to Civil for feasibility review?" : "Return this request to the requester for revision?")"
                                data-confirm-title="Revise Request"
                                data-confirm-ok="Revise">
                            <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Revise
                        </button>
                    }
                    <button type="submit" name="approvalAction" value="@ApprovalAction.Approve" class="btn btn-success btn-lg"
                            data-confirm="Approve this request?" data-confirm-title="Approve Request" data-confirm-ok="Approve">
                        <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Approve
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@* Feasibility oleh Civil (T3-1; PRD 3.1 langkah 4, BR-02, BR-54); validasi akhir di SP *@
@if (Model.CanDecideFeasibility)
{
    <div class="card mb-3 border-info">
        <div class="card-header fw-semibold"><i class="bi bi-clipboard-check me-1" aria-hidden="true"></i>Feasibility</div>
        <div class="card-body">
            <form asp-action="FeasibilityDecide" method="post" id="feasibilityForm" data-remarks-form>
                <input type="hidden" name="id" value="@r.Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="mb-3">
                    <label for="feasibilityRemarks" class="form-label">Remarks</label>
                    <textarea id="feasibilityRemarks" name="remarks" class="form-control" rows="3" maxlength="1000"
                              aria-describedby="feasibilityRemarksHelp feasibilityRemarksError"></textarea>
                    <div id="feasibilityRemarksHelp" class="form-text">Optional when feasible; required for revision or rejection. Required attachments must be complete before marking feasible.</div>
                    <div id="feasibilityRemarksError" class="invalid-feedback">Remarks are required to revise or reject.</div>
                </div>
                <div class="d-grid d-md-flex justify-content-md-end gap-2">
                    <button type="submit" name="decision" value="@FeasibilityDecision.Reject" class="btn btn-outline-danger btn-lg"
                            data-requires-remarks="true"
                            data-confirm="Reject this request? This is final." data-confirm-title="Reject Request"
                            data-confirm-ok="Reject" data-confirm-danger="true">
                        <i class="bi bi-x-octagon me-1" aria-hidden="true"></i>Reject
                    </button>
                    <button type="submit" name="decision" value="@FeasibilityDecision.Revise" class="btn btn-outline-warning btn-lg"
                            data-requires-remarks="true"
                            data-confirm="Return this request to the requester for revision? It will go through department approval again after resubmission."
                            data-confirm-title="Revise Request" data-confirm-ok="Revise">
                        <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Revise
                    </button>
                    <button type="submit" name="decision" value="@FeasibilityDecision.Feasible" class="btn btn-success btn-lg"
                            data-confirm="Mark this request as feasible and continue to document preparation?"
                            data-confirm-title="Feasible" data-confirm-ok="Feasible">
                        <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Feasible
                    </button>
                </div>
            </form>

            <hr />

            @* Ubah kategori / sub-kategori (BR-02); kategori berubah -> nomor baru (BR-54) *@
            <h2 class="h6">Change budget classification</h2>
            <form asp-action="ChangeCategory" method="post" id="categoryChangeForm" class="row g-2"
                  data-confirm="Change the budget classification? If the classification changes, the request number will change too."
                  data-confirm-title="Change Classification" data-confirm-ok="Change">
                <input type="hidden" name="id" value="@r.Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="col-12 col-md-6">
                    <label for="changeCategory" class="form-label">Budget classification</label>
                    <select id="changeCategory" name="category" class="form-select" required data-cascade-category>
                        @foreach (var c in ProjectRequest.Categories)
                        {
                            <option value="@c" selected="@(r.Category == c)">@c</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label for="changeSubCategory" class="form-label">Sub-category</label>
                    <select id="changeSubCategory" name="subCategoryId" class="form-select" required data-cascade-subcategory>
                        <option value="">-- Select --</option>
                        @foreach (var s in Model.SubCategories)
                        {
                            <option value="@s.Id" data-category="@s.Category" selected="@(r.SubCategoryId == s.Id)">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label for="changeReason" class="form-label">Reason</label>
                    <textarea id="changeReason" name="reason" class="form-control" rows="2" maxlength="1000" required></textarea>
                </div>
                <div class="col-12 d-grid d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-outline-primary btn-lg"><i class="bi bi-tag me-1" aria-hidden="true"></i>Change Classification</button>
                </div>
            </form>
        </div>
    </div>
}

@* Document Preparation oleh Civil (T3-2; PRD 3.1 langkah 5, BR-05, BR-12, BR-53); validasi akhir di SP *@
@if (Model.CanPrepareDocuments)
{
    var boqReady = r.BoqTotal is > 0;
    <div class="card mb-3 border-info">
        <div class="card-header fw-semibold"><i class="bi bi-file-earmark-ruled me-1" aria-hidden="true"></i>Document Preparation</div>
        <div class="card-body">
            @* Ringkasan kelengkapan sebelum kirim ke management *@
            <ul class="list-unstyled mb-3 request-text">
                <li>
                    <i class="bi @(boqReady ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-1" aria-hidden="true"></i>
                    BOQ total@(boqReady ? $": IDR {r.BoqTotal!.Value.ToString("#,0.##", culture)}" : " not set")
                </li>
                <li>
                    <i class="bi @(missingMandatory.Count == 0 ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-1" aria-hidden="true"></i>
                    @(missingMandatory.Count == 0 ? "Required documents attached" : "Missing documents: " + string.Join(", ", missingMandatory))
                </li>
            </ul>

            <form asp-action="SetBoqTotal" method="post" class="row g-2 align-items-end mb-3">
                <input type="hidden" name="id" value="@r.Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="col-12 col-md-8">
                    <label for="boqTotal" class="form-label">BOQ total (IDR)</label>
                    <input id="boqTotal" name="boqTotal" type="number" class="form-control" min="1" step="0.01" required
                           inputmode="decimal" value="@(r.BoqTotal?.ToString("0.##", culture))" />
                </div>
                <div class="col-12 col-md-4 d-grid">
                    <button type="submit" class="btn btn-outline-primary btn-lg"><i class="bi bi-save me-1" aria-hidden="true"></i>Save BOQ Total</button>
                </div>
            </form>

            <hr />

            <form asp-action="SendToManagement" method="post"
                  data-confirm="Send this request to management for approval? BOQ total and documents cannot be changed afterwards."
                  data-confirm-title="Send to Management" data-confirm-ok="Send">
                <input type="hidden" name="id" value="@r.Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="mb-3">
                    <label for="sendRemarks" class="form-label">Remarks</label>
                    <textarea id="sendRemarks" name="remarks" class="form-control" rows="2" maxlength="1000"></textarea>
                    <div class="form-text">Optional. Upload the BOQ (and Drawing for CAPEX) in the Attachments section below.</div>
                </div>
                <div class="d-grid d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-send-check me-1" aria-hidden="true"></i>Send to Management</button>
                </div>
            </form>
        </div>
    </div>
}

@* Planning oleh Civil (T4-1; PRD 3.3 langkah 1, ST-08/ST-09, BR-11, BR-12, BR-15); validasi akhir di SP *@
@if (Model.CanChooseExecution)
{
    var boqReady = r.BoqTotal is > 0;
    <div class="card mb-3 border-info">
        <div class="card-header fw-semibold"><i class="bi bi-calendar3 me-1" aria-hidden="true"></i>Planning: Execution Method</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <h2 class="h6"><i class="bi bi-tools me-1" aria-hidden="true"></i>In-house</h2>
                    <p class="small text-muted mb-2">Civil executes the project. Plan cost = BOQ total; the request moves to scheduling.</p>
                    <p class="small mb-0 request-text">
                        <i class="bi @(boqReady ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-1" aria-hidden="true"></i>
                        BOQ total@(boqReady ? $": IDR {r.BoqTotal!.Value.ToString("#,0.##", culture)}" : " not set")
                    </p>
                </div>
                <div class="col-12 col-md-6">
                    <h2 class="h6"><i class="bi bi-cart me-1" aria-hidden="true"></i>Outsource</h2>
                    <p class="small text-muted mb-2">Purchasing selects the vendor and enters the contract. Upload the TOR in the Attachments section below first.</p>
                    <p class="small mb-0">
                        <i class="bi @(hasTor ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-1" aria-hidden="true"></i>
                        @(hasTor ? "TOR attached" : "TOR not attached")
                    </p>
                </div>
            </div>

            <hr />

            <form asp-action="ChooseExecution" method="post">
                <input type="hidden" name="id" value="@r.Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="mb-3">
                    <label for="executionRemarks" class="form-label">Remarks</label>
                    <textarea id="executionRemarks" name="remarks" class="form-control" rows="2" maxlength="1000"></textarea>
                    <div class="form-text">Optional. The project start date, action plans and monthly cost estimate are entered in the next step (Scheduling): right after In-house, or after Purchasing completes the contract for Outsource.</div>
                </div>
                <div class="d-grid d-md-flex justify-content-md-end gap-2">
                    <button type="submit" name="executionType" value="@RequestExecutionType.Outsource" class="btn btn-outline-primary btn-lg"
                            data-confirm="Send the TOR to Purchasing for outsourcing?" data-confirm-title="Outsource" data-confirm-ok="Send TOR">
                        <i class="bi bi-cart me-1" aria-hidden="true"></i>Outsource (Send TOR)
                    </button>
                    <button type="submit" name="executionType" value="@RequestExecutionType.InHouse" class="btn btn-primary btn-lg"
                            data-confirm="Execute this project in-house? Plan cost will be set to the BOQ total and the request moves to scheduling."
                            data-confirm-title="In-house" data-confirm-ok="In-house">
                        <i class="bi bi-tools me-1" aria-hidden="true"></i>In-house
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@* Procurement oleh Purchasing (T4-1; PRD 3.3 langkah 2, BR-11, BR-12, BR-15); validasi akhir di SP *@
@if (Model.CanProcure)
{
    <div class="card mb-3 border-info">
        <div class="card-header fw-semibold"><i class="bi bi-cart me-1" aria-hidden="true"></i>Procurement</div>
        <div class="card-body">
            <ul class="list-unstyled mb-3 request-text">
                <li>
                    <i class="bi @(contract != null ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-1" aria-hidden="true"></i>
                    @(contract != null ? "Contract data saved" : "Contract data not saved")
                </li>
                <li>
                    <i class="bi @(hasContractAttachment ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-1" aria-hidden="true"></i>
                    @(hasContractAttachment ? "Contract attached" : "Contract not attached (upload in the Attachments section below)")
                </li>
            </ul>

            <form asp-action="SaveContract" method="post" class="row g-2 mb-3">
                <input type="hidden" name="id" value="@r.Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="col-12">
                    <label for="contractVendor" class="form-label">Vendor</label>
                    <select id="contractVendor" name="vendorId" class="form-select" required>
                        <option value="">-- Select --</option>
                        @foreach (var v in Model.Vendors)
                        {
                            <option value="@v.Id" selected="@(contract?.VendorId == v.Id)">@v.DisplayText</option>
                        }
                    </select>
                    @if (!Model.Vendors.Any())
                    {
                        <div class="form-text">No active vendors. Add one in Master Data &gt; Vendor.</div>
                    }
                </div>
                <div class="col-12 col-md-6 col-lg-4">
                    <label for="contractNo" class="form-label">Contract number</label>
                    <input id="contractNo" name="contractNo" class="form-control" maxlength="50" required autocomplete="off" value="@contract?.ContractNo" />
                </div>
                <div class="col-12 col-md-6 col-lg-4">
                    <label for="contractDate" class="form-label">Contract date</label>
                    <input id="contractDate" name="contractDate" type="date" class="form-control" required
                           value="@(contract?.ContractDate.ToString("yyyy-MM-dd", culture))" />
                </div>
                <div class="col-12 col-lg-4">
                    <label for="contractValue" class="form-label">Contract value (IDR)</label>
                    <input id="contractValue" name="contractValue" type="number" class="form-control" min="1" step="0.01" required
                           inputmode="decimal" value="@(contract?.ContractValue.ToString("0.##", culture))" />
                </div>
                <div class="col-12">
                    <label for="contractRemarks" class="form-label">Remarks</label>
                    <textarea id="contractRemarks" name="remarks" class="form-control" rows="2" maxlength="1000">@contract?.Remarks</textarea>
                </div>
                <div class="col-12 d-grid d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-outline-primary btn-lg"><i class="bi bi-save me-1" aria-hidden="true"></i>Save Contract</button>
                </div>
            </form>

            <hr />

            <div class="d-grid d-md-flex justify-content-md-end gap-2">
                <button type="button" class="btn btn-outline-warning btn-lg" data-bs-toggle="collapse" data-bs-target="#returnTorPanel"
                        aria-expanded="false" aria-controls="returnTorPanel">
                    <i class="bi bi-arrow-return-left me-1" aria-hidden="true"></i>Return TOR to Civil
                </button>
                <form asp-action="CompleteProcurement" method="post" class="d-grid"
                      data-confirm="Complete procurement? Plan cost will be set to the contract value and the request moves to scheduling."
                      data-confirm-title="Complete Procurement" data-confirm-ok="Complete">
                    <input type="hidden" name="id" value="@r.Id" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-file-earmark-check me-1" aria-hidden="true"></i>Complete Procurement</button>
                </form>
            </div>

            @* Kembalikan TOR (Keputusan 14-11-2026): alasan wajib *@
            <div id="returnTorPanel" class="collapse mt-3">
                <form asp-action="ReturnTor" method="post"
                      data-confirm="Return the TOR to Civil? The request goes back to planning." data-confirm-title="Return TOR"
                      data-confirm-ok="Return" data-confirm-danger="true">
                    <input type="hidden" name="id" value="@r.Id" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <div class="mb-3">
                        <label for="returnTorReason" class="form-label">Reason</label>
                        <textarea id="returnTorReason" name="reason" class="form-control" rows="2" maxlength="1000" required></textarea>
                    </div>
                    <div class="d-grid d-md-flex justify-content-md-end">
                        <button type="submit" class="btn btn-warning btn-lg"><i class="bi bi-arrow-return-left me-1" aria-hidden="true"></i>Return TOR</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* Schedule, action plan berbobot, estimasi biaya bulanan, site handover (T4-2; BR-13..BR-16, ST-10, ST-11) *@
@if (Model.Schedule is { } sch)
{
    var sum = sch.Summary;
    var inProgress = r.Status == RequestStatus.InProgress;
    var firstMonth = sum.ProjectStartDate?.ToString("yyyy-MM", culture);
    var lastMonth = sum.ProjectEndDate?.ToString("yyyy-MM", culture);
    var planCostText = sum.PlanCost.HasValue ? "IDR " + sum.PlanCost.Value.ToString("#,0.##", culture) : "-";
    <div class="card mb-3 @(Model.CanEditSchedule ? "border-info" : "")">
        <div class="card-header fw-semibold"><i class="bi bi-calendar-range me-1" aria-hidden="true"></i>Schedule &amp; Cost Estimate</div>
        <div class="card-body">
            <dl class="row mb-3 request-detail">
                <div class="col-12 col-md-6 cims-detail-item">
                    <dt>Preparation start</dt>
                    <dd>@(sum.PreparationStartAt?.ToString("dd MMM yyyy", culture) ?? "-")</dd>
                </div>
                <div class="col-12 col-md-6 cims-detail-item">
                    <dt>Project period</dt>
                    <dd>@(sum.ProjectStartDate?.ToString("dd MMM yyyy", culture) ?? "-") – @(sum.ProjectEndDate?.ToString("dd MMM yyyy", culture) ?? "-")</dd>
                </div>
                <div class="col-12 col-md-6 cims-detail-item">
                    <dt>Action plan weight</dt>
                    <dd>
                        @sum.TotalWeight.ToString("0.##", culture)% of 100%
                        @if (!sum.IsWeightComplete) { <span class="badge text-bg-warning ms-1">Incomplete</span> }
                    </dd>
                </div>
                <div class="col-12 col-md-6 cims-detail-item">
                    <dt>Cost estimate</dt>
                    <dd>
                        IDR @sum.TotalEstimate.ToString("#,0.##", culture) of @planCostText
                        @if (!sum.IsEstimateComplete) { <span class="badge text-bg-warning ms-1">Incomplete</span> }
                    </dd>
                </div>
                @if (sum.SiteHandoverDate.HasValue)
                {
                    <div class="col-12 col-md-6 cims-detail-item">
                        <dt>Site handover</dt>
                        <dd>@sum.SiteHandoverDate.Value.ToString("dd MMM yyyy", culture)</dd>
                    </div>
                }
            </dl>

            @if (Model.CanEditSchedule)
            {
                @* --- Form schedule + action plan --- *@
                <h2 class="h6">Schedule and action plans</h2>
                <form asp-action="SaveSchedule" method="post" id="scheduleForm" data-schedule-form
                      data-require-complete="@(inProgress ? "true" : "false")">
                    <input type="hidden" name="id" value="@r.Id" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <div class="row g-2 mb-3">
                        <div class="col-12 col-md-6 col-lg-4">
                            <label for="projectStartDate" class="form-label">Project start date</label>
                            <input id="projectStartDate" name="projectStartDate" type="date" class="form-control" required
                                   value="@(sum.ProjectStartDate?.ToString("yyyy-MM-dd", culture))" />
                        </div>
                    </div>

                    <div data-plan-list>
                        @for (var i = 0; i < sch.ActionPlans.Count; i++)
                        {
                            var ap = sch.ActionPlans[i];
                            <div class="cims-plan-row" data-plan-row>
                                <input type="hidden" name="actionPlans[@i].Id" value="@ap.Id" data-field="Id" />
                                <div class="row g-2 align-items-end">
                                    <div class="col-12 col-lg-4">
                                        <label class="form-label" for="ap@(i)Name">Action plan <span data-row-no>@(i + 1)</span></label>
                                        <input id="ap@(i)Name" name="actionPlans[@i].Name" class="form-control" maxlength="200" required value="@ap.Name" data-field="Name" />
                                    </div>
                                    <div class="col-12 col-md-4 col-lg-2">
                                        <label class="form-label" for="ap@(i)Weight">Weight (%)</label>
                                        <input id="ap@(i)Weight" name="actionPlans[@i].WeightPercent" type="number" class="form-control" min="0.01" max="100" step="0.01"
                                               inputmode="decimal" required value="@ap.WeightPercent.ToString("0.##", culture)" data-field="WeightPercent" data-weight />
                                    </div>
                                    <div class="col-12 col-md-4 col-lg-2">
                                        <label class="form-label" for="ap@(i)Start">Plan start</label>
                                        <input id="ap@(i)Start" name="actionPlans[@i].PlanStartDate" type="date" class="form-control" required
                                               value="@ap.PlanStartDate.ToString("yyyy-MM-dd", culture)" data-field="PlanStartDate" data-plan-start />
                                    </div>
                                    <div class="col-12 col-md-4 col-lg-2">
                                        <label class="form-label" for="ap@(i)End">Plan end</label>
                                        <input id="ap@(i)End" name="actionPlans[@i].PlanEndDate" type="date" class="form-control" required
                                               value="@ap.PlanEndDate.ToString("yyyy-MM-dd", culture)" data-field="PlanEndDate" data-plan-end />
                                    </div>
                                    <div class="col-12 col-lg-2 d-flex gap-2 justify-content-end">
                                        <button type="button" class="btn btn-outline-secondary cims-icon-btn" data-move="up" title="Move up" aria-label="Move up"><i class="bi bi-arrow-up" aria-hidden="true"></i></button>
                                        <button type="button" class="btn btn-outline-secondary cims-icon-btn" data-move="down" title="Move down" aria-label="Move down"><i class="bi bi-arrow-down" aria-hidden="true"></i></button>
                                        <button type="button" class="btn btn-outline-danger cims-icon-btn" data-remove-row title="Remove" aria-label="Remove action plan"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <template data-plan-template>
                        <div class="cims-plan-row" data-plan-row>
                            <input type="hidden" value="0" data-field="Id" />
                            <div class="row g-2 align-items-end">
                                <div class="col-12 col-lg-4">
                                    <label class="form-label">Action plan <span data-row-no></span></label>
                                    <input class="form-control" maxlength="200" required data-field="Name" />
                                </div>
                                <div class="col-12 col-md-4 col-lg-2">
                                    <label class="form-label">Weight (%)</label>
                                    <input type="number" class="form-control" min="0.01" max="100" step="0.01" inputmode="decimal" required data-field="WeightPercent" data-weight />
                                </div>
                                <div class="col-12 col-md-4 col-lg-2">
                                    <label class="form-label">Plan start</label>
                                    <input type="date" class="form-control" required data-field="PlanStartDate" data-plan-start />
                                </div>
                                <div class="col-12 col-md-4 col-lg-2">
                                    <label class="form-label">Plan end</label>
                                    <input type="date" class="form-control" required data-field="PlanEndDate" data-plan-end />
                                </div>
                                <div class="col-12 col-lg-2 d-flex gap-2 justify-content-end">
                                    <button type="button" class="btn btn-outline-secondary cims-icon-btn" data-move="up" title="Move up" aria-label="Move up"><i class="bi bi-arrow-up" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-secondary cims-icon-btn" data-move="down" title="Move down" aria-label="Move down"><i class="bi bi-arrow-down" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-danger cims-icon-btn" data-remove-row title="Remove" aria-label="Remove action plan"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </div>
                            </div>
                        </div>
                    </template>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 my-3">
                        <button type="button" class="btn btn-outline-primary" data-add-plan><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Action Plan</button>
                        <span class="small" aria-live="polite">Total weight: <span class="fw-semibold" data-weight-total>0</span>% of 100%</span>
                    </div>

                    @if (inProgress)
                    {
                        <div class="mb-3">
                            <label for="scheduleReason" class="form-label">Reason for change</label>
                            <textarea id="scheduleReason" name="reason" class="form-control" rows="2" maxlength="1000" required></textarea>
                            <div class="form-text">Required while the project is in progress. Total weight must be 100%.</div>
                        </div>
                    }
                    else
                    {
                        <p class="form-text">You can save an incomplete draft. Total weight must be 100% before site handover.</p>
                    }
                    <div class="d-grid d-md-flex justify-content-md-end">
                        <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-save me-1" aria-hidden="true"></i>Save Schedule</button>
                    </div>
                </form>

                <hr />

                @* --- Form estimasi biaya per bulan (BR-13) --- *@
                <h2 class="h6">Monthly cost estimate</h2>
                @if (firstMonth == null || lastMonth == null)
                {
                    <p class="text-muted small mb-0">Save the project start date and at least one action plan first.</p>
                }
                else
                {
                    <form asp-action="SaveCostEstimate" method="post" id="estimateForm" data-estimate-form
                          data-require-complete="@(inProgress ? "true" : "false")"
                          data-first-month="@firstMonth" data-last-month="@lastMonth"
                          data-plan-cost="@(sum.PlanCost?.ToString("0.##", culture))">
                        <input type="hidden" name="id" value="@r.Id" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <p class="form-text mt-0">Months from @sum.ProjectStartDate!.Value.ToString("MMM yyyy", culture) to @sum.ProjectEndDate!.Value.ToString("MMM yyyy", culture). Total must equal the plan cost (@planCostText).</p>

                        <div data-estimate-list>
                            @for (var i = 0; i < sch.CostEstimates.Count; i++)
                            {
                                var est = sch.CostEstimates[i];
                                <div class="row g-2 align-items-end mb-2" data-estimate-row>
                                    <div class="col-12 col-md-5">
                                        <label class="form-label" for="est@(i)Month">Month</label>
                                        <input id="est@(i)Month" name="estimates[@i].Month" type="month" class="form-control" required
                                               min="@firstMonth" max="@lastMonth" value="@est.PeriodMonth.ToString("yyyy-MM", culture)" data-field="Month" data-month />
                                    </div>
                                    <div class="col-12 col-md-5">
                                        <label class="form-label" for="est@(i)Amount">Amount (IDR)</label>
                                        <input id="est@(i)Amount" name="estimates[@i].Amount" type="number" class="form-control" min="1" step="0.01" inputmode="decimal" required
                                               value="@est.Amount.ToString("0.##", culture)" data-field="Amount" data-amount />
                                    </div>
                                    <div class="col-12 col-md-2 d-flex justify-content-end">
                                        <button type="button" class="btn btn-outline-danger cims-icon-btn" data-remove-row title="Remove" aria-label="Remove month"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                            }
                        </div>

                        <template data-estimate-template>
                            <div class="row g-2 align-items-end mb-2" data-estimate-row>
                                <div class="col-12 col-md-5">
                                    <label class="form-label">Month</label>
                                    <input type="month" class="form-control" required min="@firstMonth" max="@lastMonth" data-field="Month" data-month />
                                </div>
                                <div class="col-12 col-md-5">
                                    <label class="form-label">Amount (IDR)</label>
                                    <input type="number" class="form-control" min="1" step="0.01" inputmode="decimal" required data-field="Amount" data-amount />
                                </div>
                                <div class="col-12 col-md-2 d-flex justify-content-end">
                                    <button type="button" class="btn btn-outline-danger cims-icon-btn" data-remove-row title="Remove" aria-label="Remove month"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </div>
                            </div>
                        </template>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 my-3">
                            <button type="button" class="btn btn-outline-primary" data-add-estimate><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Month</button>
                            <span class="small" aria-live="polite">Total: IDR <span class="fw-semibold" data-estimate-total>0</span> of @planCostText</span>
                        </div>

                        @if (inProgress)
                        {
                            <div class="mb-3">
                                <label for="estimateReason" class="form-label">Reason for change</label>
                                <textarea id="estimateReason" name="reason" class="form-control" rows="2" maxlength="1000" required></textarea>
                                <div class="form-text">Required while the project is in progress.</div>
                            </div>
                        }
                        <div class="d-grid d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-save me-1" aria-hidden="true"></i>Save Cost Estimate</button>
                        </div>
                    </form>
                }

                @if (Model.CanHandover)
                {
                    <hr />

                    @* --- Site handover (ST-11) --- *@
                    <h2 class="h6">Site handover</h2>
                    <ul class="list-unstyled mb-3 request-text">
                        <li>
                            <i class="bi @(sum.ProjectStartDate.HasValue ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-1" aria-hidden="true"></i>
                            Project start date@(sum.ProjectStartDate.HasValue ? ": " + sum.ProjectStartDate.Value.ToString("dd MMM yyyy", culture) : " not set")
                        </li>
                        <li>
                            <i class="bi @(sum.IsWeightComplete ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-1" aria-hidden="true"></i>
                            Action plan weights total 100% (currently @sum.TotalWeight.ToString("0.##", culture)%)
                        </li>
                        <li>
                            <i class="bi @(sum.IsEstimateComplete ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-1" aria-hidden="true"></i>
                            Cost estimate equals the plan cost (IDR @sum.TotalEstimate.ToString("#,0.##", culture) of @planCostText)
                        </li>
                    </ul>
                    <form asp-action="SiteHandover" method="post" class="row g-2"
                          data-confirm="Record the site handover and start execution? The status will change to In Progress."
                          data-confirm-title="Site Handover" data-confirm-ok="Start Execution">
                        <input type="hidden" name="id" value="@r.Id" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <div class="col-12 col-md-6 col-lg-4">
                            <label for="handoverDate" class="form-label">Site handover date</label>
                            <input id="handoverDate" name="handoverDate" type="date" class="form-control" required
                                   min="@(sum.ProjectStartDate?.ToString("yyyy-MM-dd", culture))" max="@DateTime.Now.ToString("yyyy-MM-dd", culture)" />
                        </div>
                        <div class="col-12">
                            <label for="handoverRemarks" class="form-label">Remarks</label>
                            <textarea id="handoverRemarks" name="remarks" class="form-control" rows="2" maxlength="900"></textarea>
                            <div class="form-text">Optional. The date must be on or after the project start date and not in the future.</div>
                        </div>
                        <div class="col-12 d-grid d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-success btn-lg"><i class="bi bi-flag me-1" aria-hidden="true"></i>Site Handover &amp; Start</button>
                        </div>
                    </form>
                }
            }
            else
            {
                @* --- Tampilan baca saja --- *@
                <h2 class="h6">Action plans</h2>
                @if (!sch.ActionPlans.Any())
                {
                    <p class="text-muted small">No action plans yet.</p>
                }
                else
                {
                    <div class="table-responsive mb-3">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="cims-col-fit">#</th>
                                    <th>Action plan</th>
                                    <th class="cims-col-fit text-end">Weight</th>
                                    <th class="d-none d-md-table-cell cims-col-fit">Plan start</th>
                                    <th class="d-none d-md-table-cell cims-col-fit">Plan end</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ap in sch.ActionPlans)
                                {
                                    <tr>
                                        <td class="cims-col-fit">@ap.SortOrder</td>
                                        <td class="request-text">
                                            @ap.Name
                                            <div class="small text-muted d-md-none">@ap.PlanStartDate.ToString("dd MMM yyyy", culture) – @ap.PlanEndDate.ToString("dd MMM yyyy", culture)</div>
                                        </td>
                                        <td class="cims-col-fit text-end">@ap.WeightPercent.ToString("0.##", culture)%</td>
                                        <td class="d-none d-md-table-cell cims-col-fit">@ap.PlanStartDate.ToString("dd MMM yyyy", culture)</td>
                                        <td class="d-none d-md-table-cell cims-col-fit">@ap.PlanEndDate.ToString("dd MMM yyyy", culture)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <h2 class="h6">Monthly cost estimate</h2>
                @if (!sch.CostEstimates.Any())
                {
                    <p class="text-muted small mb-0">No cost estimate yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Month</th>
                                    <th class="text-end">Amount (IDR)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var est in sch.CostEstimates)
                                {
                                    <tr>
                                        <td>@est.PeriodMonth.ToString("MMM yyyy", culture)</td>
                                        <td class="text-end">@est.Amount.ToString("#,0.##", culture)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="fw-semibold">
                                    <td>Total</td>
                                    <td class="text-end">@sum.TotalEstimate.ToString("#,0.##", culture)</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
}

@* (i) Preliminary Data *@
<div class="card mb-3">
    <div class="card-header fw-semibold">Preliminary Data</div>
    <div class="card-body">
        <dl class="row mb-0 request-detail">
            <div class="col-12 cims-detail-item">
                <dt>Request title</dt>
                <dd>@r.Title</dd>
            </div>
            <div class="col-12 col-md-6 cims-detail-item">
                <dt>Request number</dt>
                <dd>@(r.RequestNo ?? "Generated on submit")</dd>
            </div>
            <div class="col-12 col-md-6 cims-detail-item">
                <dt>Company</dt>
                <dd>@r.CoCode</dd>
            </div>
            <div class="col-12 col-md-6 cims-detail-item">
                <dt>Requesting department</dt>
                <dd>@Text(r.DeptName)@(string.IsNullOrEmpty(r.ABRV) ? "" : $" ({r.ABRV})")</dd>
            </div>
            <div class="col-12 col-md-6 cims-detail-item">
                <dt>Requester</dt>
                <dd>@Text(r.RequesterName)</dd>
            </div>
            <div class="col-12 col-md-6 cims-detail-item">
                <dt>Budget classification</dt>
                <dd>@r.Category@(string.IsNullOrEmpty(r.SubCategoryName) ? "" : $" · {r.SubCategoryName}")</dd>
            </div>
            <div class="col-12 col-md-6 cims-detail-item">
                <dt>Budget remarks</dt>
                <dd>@Text(ProjectRequest.BudgetRemarksLabel(r.BudgetRemarks))</dd>
            </div>
            <div class="col-12 col-md-6 cims-detail-item">
                <dt>PIC of project</dt>
                <dd>@Text(r.PicName)@(string.IsNullOrEmpty(r.PicEmployeeCode) ? "" : $" ({r.PicEmployeeCode})")</dd>
            </div>
            <div class="col-12 col-md-6 cims-detail-item">
                <dt>Cost center</dt>
                <dd>@Text(r.CostCenterName)</dd>
            </div>
            <div class="col-12 col-md-6 cims-detail-item">
                <dt>Location</dt>
                <dd>@Text(r.LocationName)</dd>
            </div>
            <div class="col-12 col-md-6 cims-detail-item">
                <dt>Target completion</dt>
                <dd>@(r.TargetCompletionDate?.ToString("dd MMM yyyy", culture) ?? "-")</dd>
            </div>
            <div class="col-12 col-md-6 cims-detail-item">
                <dt>Section area</dt>
                <dd>
                    @if (r.AreaSize.HasValue)
                    {
                        @($"{r.AreaLength?.ToString("0.##", culture)} × {r.AreaWidth?.ToString("0.##", culture)} m = {r.AreaSize.Value.ToString("#,0.##", culture)} m²")
                    }
                    else
                    {
                        @("-")
                    }
                </dd>
            </div>
            <div class="col-12 col-md-6 cims-detail-item">
                <dt>Budget expectation</dt>
                <dd>@(r.BudgetExpectation.HasValue ? "IDR " + r.BudgetExpectation.Value.ToString("#,0", culture) : "-")</dd>
            </div>
            @if (r.BoqTotal.HasValue)
            {
                <div class="col-12 col-md-6 cims-detail-item">
                    <dt>BOQ total</dt>
                    <dd>IDR @r.BoqTotal.Value.ToString("#,0.##", culture)</dd>
                </div>
            }
            @if (!string.IsNullOrEmpty(r.ExecutionType))
            {
                <div class="col-12 col-md-6 cims-detail-item">
                    <dt>Execution</dt>
                    <dd>@RequestExecutionType.Label(r.ExecutionType)</dd>
                </div>
            }
            @if (r.PlanCost.HasValue)
            {
                <div class="col-12 col-md-6 cims-detail-item">
                    <dt>Plan cost</dt>
                    <dd>IDR @r.PlanCost.Value.ToString("#,0.##", culture)</dd>
                </div>
            }
            @if (r.PreparationStartAt.HasValue)
            {
                <div class="col-12 col-md-6 cims-detail-item">
                    <dt>Preparation start</dt>
                    <dd>@r.PreparationStartAt.Value.ToString("dd MMM yyyy HH:mm", culture)</dd>
                </div>
            }
            <div class="col-12 col-md-6 cims-detail-item">
                <dt>Created</dt>
                <dd>@r.CreatedAt.ToString("dd MMM yyyy HH:mm", culture)@(string.IsNullOrEmpty(r.CreatedBy) ? "" : $" by {r.CreatedBy}")</dd>
            </div>
            <div class="col-12 col-md-6 cims-detail-item">
                <dt>Updated</dt>
                <dd>@(r.UpdatedAt?.ToString("dd MMM yyyy HH:mm", culture) ?? "-")@(string.IsNullOrEmpty(r.UpdatedBy) ? "" : $" by {r.UpdatedBy}")</dd>
            </div>
        </dl>
    </div>
</div>

@* (ii) Business Justification *@
<div class="card mb-3">
    <div class="card-header fw-semibold">Business Justification</div>
    <div class="card-body">
        <dl class="row mb-0 request-detail">
            <div class="col-12 cims-detail-item"><dt>Background</dt><dd class="request-multiline">@Text(r.Background)</dd></div>
            <div class="col-12 cims-detail-item"><dt>Objective</dt><dd class="request-multiline">@Text(r.Objective)</dd></div>
            <div class="col-12 cims-detail-item"><dt>Impact to operational</dt><dd class="request-multiline">@Text(r.OperationalImpact)</dd></div>
            <div class="col-12 cims-detail-item"><dt>Risk if not approved</dt><dd class="request-multiline">@Text(r.RiskIfNotApproved)</dd></div>
            <div class="col-12 cims-detail-item"><dt>Expected benefits</dt><dd class="request-multiline">@Text(r.ExpectedBenefits)</dd></div>
            <div class="col-12 cims-detail-item"><dt>Alternatives</dt><dd class="request-multiline">@Text(r.Alternatives)</dd></div>
            <div class="col-12 cims-detail-item"><dt>Special request / note</dt><dd class="request-multiline">@Text(r.SpecialNote)</dd></div>
            @if (r.Category == "CAPEX")
            {
                <div class="col-12 col-md-4 cims-detail-item">
                    <dt>Expected ROI</dt>
                    <dd>@(r.ExpectedRoiPercent.HasValue ? r.ExpectedRoiPercent.Value.ToString("0.##", culture) + " %" : "-")</dd>
                </div>
                <div class="col-12 col-md-8 cims-detail-item"><dt>ROI explanation</dt><dd class="request-multiline">@Text(r.RoiExplanation)</dd></div>
            }
        </dl>
    </div>
</div>

@* (iii) Environment Assessment *@
<div class="card mb-3">
    <div class="card-header fw-semibold">Environment Assessment</div>
    <div class="card-body">
        @if (!Model.Assessment.Any())
        {
            <p class="text-muted mb-0">No assessment answers.</p>
        }
        else
        {
            <ol class="list-unstyled mb-0 request-assessment">
                @for (var i = 0; i < Model.Assessment.Count; i++)
                {
                    var a = Model.Assessment[i];
                    <li class="request-assessment-item d-flex justify-content-between align-items-start gap-3">
                        <span class="request-text">@(i + 1). @a.QuestionText</span>
                        @if (a.Answer == true)
                        {
                            <span class="badge text-bg-success">Yes</span>
                        }
                        else if (a.Answer == false)
                        {
                            <span class="badge text-bg-secondary">No</span>
                        }
                        else
                        {
                            <span class="badge text-bg-light border">Not answered</span>
                        }
                    </li>
                }
            </ol>
        }
    </div>
</div>

@* (iv) Additional Information *@
<div class="card mb-3">
    <div class="card-header fw-semibold">Additional Information</div>
    <div class="card-body">
        <p class="mb-0 request-multiline">@Text(r.AdditionalInfo)</p>
    </div>
</div>

@* Kontrak outsource (BR-11); hanya tampil (form ada di kartu Procurement) *@
@if (contract != null && !Model.CanProcure)
{
    <div class="card mb-3">
        <div class="card-header fw-semibold">Contract</div>
        <div class="card-body">
            <dl class="row mb-0 request-detail">
                <div class="col-12 cims-detail-item">
                    <dt>Vendor</dt>
                    <dd>@contract.VendorCode - @contract.VendorName</dd>
                </div>
                <div class="col-12 col-md-6 cims-detail-item">
                    <dt>Contract number</dt>
                    <dd>@contract.ContractNo</dd>
                </div>
                <div class="col-12 col-md-6 cims-detail-item">
                    <dt>Contract date</dt>
                    <dd>@contract.ContractDate.ToString("dd MMM yyyy", culture)</dd>
                </div>
                <div class="col-12 col-md-6 cims-detail-item">
                    <dt>Contract value</dt>
                    <dd>IDR @contract.ContractValue.ToString("#,0.##", culture)</dd>
                </div>
                <div class="col-12 col-md-6 cims-detail-item">
                    <dt>Entered by</dt>
                    <dd>@(contract.UpdatedBy ?? contract.CreatedBy) · @((contract.UpdatedAt ?? contract.CreatedAt).ToString("dd MMM yyyy HH:mm", culture))</dd>
                </div>
                <div class="col-12 cims-detail-item">
                    <dt>Remarks</dt>
                    <dd class="request-text">@Text(contract.Remarks)</dd>
                </div>
            </dl>
        </div>
    </div>
}

@* Lampiran (BR-42..BR-46) *@
<div class="card mb-3">
    <div class="card-header fw-semibold">Attachments</div>
    <div class="card-body">
        @if (Model.CanManageAttachments && missingMandatory.Count > 0)
        {
            <p class="small text-warning-emphasis">Required before @(Model.CanPrepareDocuments ? "sending to management" : Model.CanDecideFeasibility ? "marking feasible" : Model.CanChooseExecution ? "outsourcing" : Model.CanProcure ? "completing procurement" : "submit"): @string.Join(", ", missingMandatory).</p>
        }

        @if (!Model.Attachments.Any())
        {
            <p class="text-muted">No attachments.</p>
        }
        else
        {
            <ul class="list-group mb-3">
                @foreach (var att in Model.Attachments)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <div class="request-text">
                            <div class="text-muted small">@att.AttachmentTypeName</div>
                            <a asp-action="DownloadAttachment" asp-route-id="@att.Id">@att.OriginalFileName</a>
                            <div class="text-muted small">@Size(att.FileSizeBytes) · @att.CreatedAt.ToString("dd MMM yyyy HH:mm", culture)@(string.IsNullOrEmpty(att.CreatedBy) ? "" : $" by {att.CreatedBy}")</div>
                        </div>
                        @if (Model.CanManageAttachments)
                        {
                            <form asp-action="DeactivateAttachment" method="post"
                                  data-confirm="Remove this attachment?" data-confirm-title="Remove Attachment"
                                  data-confirm-ok="Remove" data-confirm-danger="true">
                                <input type="hidden" name="id" value="@r.Id" />
                                <input type="hidden" name="attachmentId" value="@att.Id" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="btn btn-outline-danger cims-icon-btn" title="Remove" aria-label="Remove @att.OriginalFileName">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }

        @if (Model.CanManageAttachments && Model.AttachmentTypes.Any())
        {
            <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
                <input type="hidden" name="id" value="@r.Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="col-12 col-md-5">
                    <label for="attachmentTypeId" class="form-label">Attachment type</label>
                    <select id="attachmentTypeId" name="attachmentTypeId" class="form-select" required>
                        @foreach (var t in Model.AttachmentTypes)
                        {
                            <option value="@t.Id">@t.Name (@t.AllowedExtensions, max @t.MaxSizeMB MB)@(IsMandatory(t) ? " – required" : "")</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-5">
                    <label for="file" class="form-label">File</label>
                    <input id="file" name="file" type="file" class="form-control" required />
                </div>
                <div class="col-12 col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-upload me-1" aria-hidden="true"></i>Upload</button>
                </div>
            </form>
        }
    </div>
</div>

@* Log perubahan kategori (BR-02), terbaru di atas *@
@if (Model.CategoryChanges.Any())
{
    <div class="card mb-3">
        <h2 class="h6 mb-0">
            <button type="button" class="cims-card-toggle" data-bs-toggle="collapse" data-bs-target="#cardCategoryChanges"
                    aria-expanded="false" aria-controls="cardCategoryChanges">
                <i class="bi bi-tag" aria-hidden="true"></i>Classification Changes
                <span class="badge request-status-chip">@Model.CategoryChanges.Count</span>
                <i class="bi bi-chevron-down cims-card-toggle-chevron" aria-hidden="true"></i>
            </button>
        </h2>
        <div id="cardCategoryChanges" class="collapse">
        <div class="card-body">
            <ol class="list-unstyled mb-0 request-timeline">
                @foreach (var c in Model.CategoryChanges)
                {
                    <li class="request-timeline-item">
                        <span class="request-timeline-icon text-bg-info"><i class="bi bi-tag" aria-hidden="true"></i></span>
                        <div class="d-flex flex-wrap align-items-center gap-1">
                            <span class="badge request-status-chip">@c.OldCategory · @Text(c.OldSubCategoryName)</span>
                            <i class="bi bi-arrow-right text-muted" aria-label="to"></i>
                            <span class="badge request-status-chip">@c.NewCategory · @Text(c.NewSubCategoryName)</span>
                            <span class="text-muted request-text">
                                @c.ChangedAt.ToString("dd MMM yyyy HH:mm", culture) ·
                                <span class="fw-semibold text-body">@(string.IsNullOrEmpty(c.ChangedByName) ? c.ChangedBy : c.ChangedByName)</span>
                            </span>
                        </div>
                        @if (c.IsRenumbered)
                        {
                            <div class="text-muted request-text">Request no.: @Text(c.OldRequestNo) → @Text(c.NewRequestNo)</div>
                        }
                        <div class="text-muted request-multiline"><span class="fw-semibold">Reason:</span> @c.Reason</div>
                    </li>
                }
            </ol>
        </div>
        </div>
    </div>
}

@* Langkah approval (snapshot BR-37; ronde terakhir per titik); tertutup default, klik untuk membuka *@
<div class="card mb-3">
    <h2 class="h6 mb-0">
        <button type="button" class="cims-card-toggle" data-bs-toggle="collapse" data-bs-target="#cardApprovalSteps"
                aria-expanded="false" aria-controls="cardApprovalSteps">
            <i class="bi bi-diagram-3" aria-hidden="true"></i>Approval Steps
            @if (Model.ApprovalSteps.FirstOrDefault(s => s.IsCurrent) is { } cur)
            {
                <span class="badge text-bg-info fw-normal">Waiting: @(string.IsNullOrEmpty(cur.RoleName) ? cur.RoleCode : cur.RoleName)</span>
            }
            <i class="bi bi-chevron-down cims-card-toggle-chevron" aria-hidden="true"></i>
        </button>
    </h2>
    <div id="cardApprovalSteps" class="collapse">
    <div class="card-body">
        @if (!Model.ApprovalSteps.Any())
        {
            <p class="text-muted mb-0">Approval steps are set when the request is submitted.</p>
        }
        else
        {
            foreach (var group in Model.ApprovalSteps.GroupBy(s => s.Point))
            {
                <h2 class="h6 request-step-point">@group.First().PointLabel</h2>
                <ol class="list-group list-group-numbered mb-3">
                    @foreach (var s in group.OrderBy(s => s.StepOrder))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-start gap-2@(s.IsCurrent ? " request-step-current" : "")"
                            aria-current="@(s.IsCurrent ? "step" : null)">
                            <div class="ms-2 me-auto request-text">
                                <div class="fw-semibold">@(string.IsNullOrEmpty(s.RoleName) ? s.RoleCode : s.RoleName)</div>
                                @if (s.ActedAt.HasValue)
                                {
                                    <div class="text-muted small">@s.ActedAt.Value.ToString("dd MMM yyyy HH:mm", culture)@(string.IsNullOrEmpty(s.ActedBy) ? "" : $" by {s.ActedBy}")</div>
                                }
                                else if (s.IsCurrent && s.StartedAt.HasValue)
                                {
                                    <div class="text-muted small">Waiting since @s.StartedAt.Value.ToString("dd MMM yyyy HH:mm", culture)</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(s.Remarks))
                                {
                                    <div class="small request-multiline">@s.Remarks</div>
                                }
                            </div>
                            <span class="badge @s.StatusBadgeClass">@s.StatusLabel</span>
                        </li>
                    }
                </ol>
            }
        }
    </div>
    </div>
</div>

@* Riwayat aksi (terbaru di atas); tertutup default, klik untuk membuka *@
<div class="card mb-3">
    <h2 class="h6 mb-0">
        <button type="button" class="cims-card-toggle" data-bs-toggle="collapse" data-bs-target="#cardHistory"
                aria-expanded="false" aria-controls="cardHistory">
            <i class="bi bi-clock-history" aria-hidden="true"></i>Workflow History
            <span class="badge request-status-chip">@Model.History.Count</span>
            <i class="bi bi-chevron-down cims-card-toggle-chevron" aria-hidden="true"></i>
        </button>
    </h2>
    <div id="cardHistory" class="collapse">
    <div class="card-body">
        @if (!Model.History.Any())
        {
            <p class="text-muted mb-0">No history yet.</p>
        }
        else
        {
            <ol class="list-unstyled mb-0 request-timeline">
                @foreach (var h in Model.History)
                {
                    <li class="request-timeline-item">
                        <span class="request-timeline-icon @h.ActionBadgeClass"><i class="bi @h.ActionIcon" aria-hidden="true"></i></span>
                        @* Satu baris: aksi, status asal -> tujuan, waktu, pelaku; catatan hanya bila ada *@
                        <div class="d-flex flex-wrap align-items-center gap-1">
                            <span class="badge @h.ActionBadgeClass"><i class="bi @h.ActionIcon me-1" aria-hidden="true"></i>@h.ActionLabel</span>
                            @if (!string.IsNullOrEmpty(h.FromStatus))
                            {
                                <span class="badge request-status-chip">@RequestStatus.Label(h.FromStatus)</span>
                            }
                            @if (!string.IsNullOrEmpty(h.ToStatus))
                            {
                                <i class="bi bi-arrow-right text-muted" aria-label="to"></i>
                                <span class="badge request-status-chip">@RequestStatus.Label(h.ToStatus)</span>
                            }
                            <span class="text-muted request-text">
                                @h.ActionAt.ToString("dd MMM yyyy HH:mm", culture) ·
                                <span class="fw-semibold text-body">@(string.IsNullOrEmpty(h.ActionByName) ? h.ActionBy : h.ActionByName)</span>
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(h.Remarks))
                        {
                            <div class="text-muted request-multiline"><span class="fw-semibold">Remarks:</span> @h.Remarks</div>
                        }
                    </li>
                }
            </ol>
        }
    </div>
    </div>
</div>

@* Pembatalan (BR-09): alasan wajib; validasi akhir di SP *@
@if (Model.CanCancel)
{
    <div class="card mb-3 border-danger-subtle">
        <div class="card-header fw-semibold">Cancel Request</div>
        <div class="card-body">
            <form asp-action="Cancel" method="post"
                  data-confirm="Cancel this request? This cannot be undone." data-confirm-title="Cancel Request"
                  data-confirm-ok="Cancel Request" data-confirm-danger="true">
                <input type="hidden" name="id" value="@r.Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="mb-3">
                    <label for="reason" class="form-label">Cancellation reason</label>
                    <textarea id="reason" name="reason" class="form-control" rows="3" maxlength="1000" required></textarea>
                </div>
                <div class="d-grid d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-outline-danger btn-lg"><i class="bi bi-x-circle me-1" aria-hidden="true"></i>Cancel Request</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/request-approval.js" asp-append-version="true"></script>
    @if (Model.CanEditSchedule)
    {
        <script src="~/js/request-schedule.js" asp-append-version="true"></script>
    }
}
