@model (int Index, ActualItem? Item)
@{
    // Satu baris item actual cost (PRD 6.4). Index -1 = baris template (nama field diisi request-actual.js).
    var culture = System.Globalization.CultureInfo.InvariantCulture;
    var it = Model.Item;
    var i = Model.Index;
    string? Name(string field) => i >= 0 ? $"items[{i}].{field}" : null;
    string? Id(string field) => i >= 0 ? $"act{i}{field}" : null;
}
<div class="cims-plan-row" data-actual-row>
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-4 col-lg-2">
            <label class="form-label" for="@Id("ItemType")">Type</label>
            <select class="form-select" id="@Id("ItemType")" name="@Name("ItemType")" required data-field="ItemType">
                @foreach (var t in ActualItemType.All)
                {
                    <option value="@t.Key" selected="@(it?.ItemType == t.Key)">@t.Value</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-8 col-lg-4">
            <label class="form-label" for="@Id("ItemName")">Item name</label>
            <input class="form-control" id="@Id("ItemName")" name="@Name("ItemName")" maxlength="200" required value="@it?.ItemName" data-field="ItemName" />
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label" for="@Id("Qty")">Qty</label>
            <input class="form-control" id="@Id("Qty")" name="@Name("Qty")" type="number" min="0.0001" step="0.0001" inputmode="decimal" required
                   value="@(it?.Qty.ToString("0.####", culture))" data-field="Qty" data-qty />
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label" for="@Id("Unit")">Unit</label>
            <input class="form-control" id="@Id("Unit")" name="@Name("Unit")" maxlength="30" required list="unitOptions" value="@it?.Unit" data-field="Unit" />
        </div>
        <div class="col-12 col-md-6 col-lg-2">
            <label class="form-label" for="@Id("UnitPrice")">Unit price (IDR)</label>
            <input class="form-control" id="@Id("UnitPrice")" name="@Name("UnitPrice")" type="number" min="0.01" step="0.01" inputmode="decimal" required
                   value="@(it?.UnitPrice.ToString("0.##", culture))" data-field="UnitPrice" data-price />
        </div>
        <div class="col-12 col-md-4 col-lg-3">
            <label class="form-label" for="@Id("Amount")">Amount (IDR)</label>
            <input class="form-control" id="@Id("Amount")" name="@Name("Amount")" type="number" min="0.01" step="0.01" inputmode="decimal" required
                   value="@(it?.Amount.ToString("0.##", culture))" data-field="Amount" data-amount />
        </div>
        <div class="col-12 col-md-4 col-lg-3">
            <label class="form-label" for="@Id("ReferenceNo")">Reference (PO/GR/Journal)</label>
            <input class="form-control" id="@Id("ReferenceNo")" name="@Name("ReferenceNo")" maxlength="100" value="@it?.ReferenceNo" data-field="ReferenceNo" />
        </div>
        <div class="col-10 col-md-3 col-lg-5">
            <label class="form-label" for="@Id("Notes")">Notes</label>
            <input class="form-control" id="@Id("Notes")" name="@Name("Notes")" maxlength="500" value="@it?.Notes" data-field="Notes" />
        </div>
        <div class="col-2 col-md-1 d-flex justify-content-end">
            <button type="button" class="btn btn-outline-danger cims-icon-btn" data-remove-row title="Remove" aria-label="Remove item"><i class="bi bi-trash" aria-hidden="true"></i></button>
        </div>
    </div>
</div>
