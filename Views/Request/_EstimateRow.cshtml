@model (int Index, ProjectCostEstimateItem? Item, string? MinMonth, string? MaxMonth, bool Locked)
@{
    // Satu baris estimasi biaya bulanan (BR-13). Index -1 = baris template (nama field diisi request-schedule.js).
    // Locked (penyesuaian addendum, BR-85): bulan sebelum bulan berjalan tidak bisa diubah / dihapus. Validasi akhir di SP.
    var culture = System.Globalization.CultureInfo.InvariantCulture;
    var est = Model.Item;
    var i = Model.Index;
    string? Name(string field) => i >= 0 ? $"estimates[{i}].{field}" : null;
    string? Id(string field) => i >= 0 ? $"est{i}{field}" : null;
}
<div class="row g-2 align-items-end mb-2" data-estimate-row>
    <div class="col-12 col-md-5">
        <label class="form-label" for="@Id("Month")">
            Month
            @if (Model.Locked)
            {
                <span class="badge text-bg-light border ms-1" title="Past month: cannot be changed in an addendum adjustment"><i class="bi bi-lock" aria-hidden="true"></i> Past</span>
            }
        </label>
        <input id="@Id("Month")" name="@Name("Month")" type="month" class="form-control" required
               min="@(Model.Locked ? null : Model.MinMonth)" max="@(Model.Locked ? null : Model.MaxMonth)"
               value="@(est?.PeriodMonth.ToString("yyyy-MM", culture))" data-field="Month" data-month readonly="@Model.Locked" />
    </div>
    <div class="col-12 col-md-5">
        <label class="form-label" for="@Id("Amount")">Amount (IDR)</label>
        <input id="@Id("Amount")" name="@Name("Amount")" type="number" class="form-control" min="1" step="0.01" inputmode="decimal" required
               value="@(est?.Amount.ToString("0.##", culture))" data-field="Amount" data-amount readonly="@Model.Locked" />
    </div>
    <div class="col-12 col-md-2 d-flex justify-content-end">
        @if (!Model.Locked)
        {
            <button type="button" class="btn btn-outline-danger cims-icon-btn" data-remove-row title="Remove" aria-label="Remove month"><i class="bi bi-trash" aria-hidden="true"></i></button>
        }
    </div>
</div>
