<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CIMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CIMS.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header sticky-top">
        <button class="btn app-header-toggle d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar"
                aria-controls="appSidebar" aria-label="Buka menu">
            <i class="bi bi-list" aria-hidden="true"></i>
        </button>
        <a class="app-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="app-brand-name">CIMS</span>
            <span class="app-brand-sub d-none d-sm-block">Civil Integrated Management System</span>
        </a>
        <div class="app-tagline d-none d-lg-block">Better Planning | Higher Efficiency | Sustainable Facility</div>
        @await Component.InvokeAsync("Profile")
    </header>

    <div class="app-shell">
        <aside class="app-sidebar-col">
            <nav id="appSidebar" class="offcanvas-lg offcanvas-start app-sidebar" tabindex="-1"
                 aria-label="Menu utama" data-bs-scroll="false">
                <div class="offcanvas-header d-lg-none">
                    <span class="offcanvas-title fw-semibold">CIMS</span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="Tutup menu"></button>
                </div>
                <div class="offcanvas-body app-sidebar-body">
                    <partial name="_Sidebar" />
                </div>
            </nav>
        </aside>

        <main role="main" class="app-content cims-compact">
            <div class="container-fluid">
                @{
                    var contentWidth = ViewData["ContentWidth"]?.ToString();
                    var contentWidthClass = contentWidth switch
                    {
                        "narrow" => "cims-content--narrow",
                        "full" => "cims-content--full",
                        _ => string.Empty
                    };
                }
                <div class="cims-content @contentWidthClass">
                    @RenderBody()
                </div>
            </div>
        </main>
    </div>

    <div id="toast-container" class="toast-container position-fixed end-0 p-3 app-toast-container" aria-live="polite"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notify.js" asp-append-version="true"></script>
    <partial name="_Notifications" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
