@model SubCategoryFormViewModel
@{
    var isEdit = Model.Id > 0;
    var action = isEdit ? "Edit" : "Create";
    var cancelAction = isEdit ? "Details" : "Index";
    // URL list asal (filter, sort, halaman) dari Index; null = alur default.
    var returnUrl = ViewData["ReturnUrl"] as string;
    var cancelUrl = returnUrl ?? Url.Action(cancelAction, new { id = isEdit ? Model.Id : (int?)null });
}

<form id="sub-category-form" asp-controller="SubCategory" asp-action="@action" asp-route-id="@(isEdit ? Model.Id : (int?)null)" method="post" novalidate data-dirty-guard>
    <input type="hidden" asp-for="Id" />
    @if (returnUrl != null)
    {
        <input type="hidden" name="returnUrl" value="@returnUrl" />
    }

    <div class="row g-3">
        <div class="col-12 col-md-6 col-lg-4">
            <label asp-for="Category" class="form-label"></label>
            @if (isEdit)
            {
                @* Category tidak bisa diubah setelah dibuat (menjaga konsistensi request). *@
                <input asp-for="Category" class="form-control" readonly />
                <div class="form-text">Category cannot be changed.</div>
            }
            else
            {
                <select asp-for="Category" class="form-select">
                    <option value="">-- Select category --</option>
                    @foreach (var c in SubCategory.Categories)
                    {
                        <option value="@c" selected="@(Model.Category == c)">@c</option>
                    }
                </select>
            }
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <label asp-for="Code" class="form-label"></label>
            @if (isEdit)
            {
                @* Code tidak bisa diubah setelah dibuat (dipakai modul lain sebagai kunci). *@
                <input asp-for="Code" class="form-control" readonly />
                <div class="form-text">Code cannot be changed.</div>
            }
            else
            {
                <input asp-for="Code" class="form-control text-uppercase" autocomplete="off" placeholder="e.g. ROAD_WORKS" />
            }
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <label asp-for="SortOrder" class="form-label"></label>
            <input asp-for="SortOrder" type="number" min="1" max="999" class="form-control" />
            <span asp-validation-for="SortOrder" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autocomplete="off" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-12">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" role="switch" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-12">
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <a href="@cancelUrl" class="btn btn-outline-secondary btn-lg"
                   data-confirm="Unsaved changes will be lost." data-confirm-title="Discard changes?"
                   data-confirm-ok="Yes, discard" data-confirm-danger="true" data-confirm-if-dirty="#sub-category-form">Cancel</a>
                <button type="submit" class="btn btn-primary btn-lg">@(isEdit ? "Save Changes" : "Save")</button>
            </div>
        </div>
    </div>
</form>
