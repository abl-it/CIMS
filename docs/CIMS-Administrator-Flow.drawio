        <mxCell id="c1" value="Akses pengguna: bagaimana CIMS memeriksa, dan cara memberi akses" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1100" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Pengguna dan role diambil dari portal (home..users). CIMS tidak punya halaman pengelolaan user." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="42" width="1100" height="22" as="geometry" />
