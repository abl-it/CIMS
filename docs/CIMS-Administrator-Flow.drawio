        <mxCell id="c4" value="&lt;b&gt;Pengguna&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;login di portal, buka CIMS dari portal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ede7f6;strokeColor=#5e35b1;" vertex="1" parent="1">
          <mxGeometry x="150.0" y="135" width="300" height="56" as="geometry" />
