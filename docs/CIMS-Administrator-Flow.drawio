          <mxGeometry x="205.0" y="335" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="Punya role&lt;br&gt;CIMS?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
