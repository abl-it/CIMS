  <diagram id="g7" name="7. Status &amp; KPI">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="Cara membaca status project di Dashboard, dan KPI review" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1400" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Status dihitung otomatis dari progress mingguan dan actual cost bulanan. Ambang diatur administrator di halaman Settings." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="42" width="1400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Status jadwal (BR-68)&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal'&gt;deviasi = % progress actual − % progress plan (minggu berjalan)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#7f6000;strokeColor=#7f6000;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="420" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;On Track&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;deviasi ≥ −5 poin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#38761d;" vertex="1" parent="1">
          <mxGeometry x="40" y="145" width="420" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Slightly Delay&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;−15 s.d. −5 poin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#bf9000;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="420" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Delay&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&amp;lt; −15 poin, atau tanggal selesai plan lewat dan progress &amp;lt; 100%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#990000;" vertex="1" parent="1">
          <mxGeometry x="40" y="255" width="420" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="Status biaya (BR-69)&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal'&gt;rasio = Σ actual ÷ Σ estimasi s.d. bulan closing terakhir&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#7f6000;strokeColor=#7f6000;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="345" width="420" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;On Track&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;rasio ≤ 100%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#38761d;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="420" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;At Risk&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;rasio &amp;gt; 100% s.d. 110%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#bf9000;" vertex="1" parent="1">
          <mxGeometry x="40" y="465" width="420" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;Over Budget&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;rasio &amp;gt; 110%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#990000;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="420" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="Status keseluruhan (BR-70)&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal'&gt;= status terburuk dari jadwal dan biaya&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#7f6000;strokeColor=#7f6000;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;On Track&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;jadwal On Track dan biaya On Track&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#38761d;" vertex="1" parent="1">
          <mxGeometry x="640" y="145" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;b&gt;At Risk&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;jadwal Slightly Delay atau biaya At Risk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#bf9000;" vertex="1" parent="1">
          <mxGeometry x="640" y="220" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;Delayed&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;jadwal Delay atau biaya Over Budget&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#990000;" vertex="1" parent="1">
          <mxGeometry x="640" y="295" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="• Selama periode Preparation (sebelum tanggal mulai project) status jadwal belum dihitung.&lt;br&gt;• Project yang belum punya actual cost berstatus biaya On Track.&lt;br&gt;• Ambang default di atas disimpan di tabel AppSetting (SCHEDULE_* dan COST_*) dan dapat diubah administrator." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="390" width="760" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="KPI review (PRD 8.2): hanya untuk review, tanpa tindak lanjut di CIMS" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#7f6000;strokeColor=#7f6000;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="1360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;b&gt;KPI-01 Ketepatan waktu&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;% project Closed yang selesai ≤ tanggal selesai plan&lt;/font&gt;&lt;br&gt;&lt;b&gt;Target ≥ 90% · bobot 30%&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e8f1fb;strokeColor=#3c78d8;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="325" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;KPI-02 Deviasi biaya&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;|Σ actual − Σ plan cost| ÷ Σ plan cost (project Closed)&lt;/font&gt;&lt;br&gt;&lt;b&gt;Target ≤ 5% · bobot 30%&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e8f1fb;strokeColor=#3c78d8;" vertex="1" parent="1">
          <mxGeometry x="385" y="660" width="325" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="&lt;b&gt;KPI-03 Kepuasan user&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;rata-rata skor survei pada periode&lt;/font&gt;&lt;br&gt;&lt;b&gt;Target ≥ 85% · bobot 25%&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e8f1fb;strokeColor=#3c78d8;" vertex="1" parent="1">
          <mxGeometry x="730" y="660" width="325" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;b&gt;KPI-04 Lead time approval&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Submit s.d. approval management terakhir (hari kerja)&lt;/font&gt;&lt;br&gt;&lt;b&gt;Target ≤ 10 hari · bobot 15%&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e8f1fb;strokeColor=#3c78d8;" vertex="1" parent="1">
          <mxGeometry x="1075" y="660" width="325" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="Halaman KPI belum tersedia di aplikasi (rencana). Data sumbernya (project Closed, actual cost, survei, riwayat approval) sudah tercatat di CIMS. Frekuensi bulanan; baseline diukur 3 bulan pertama setelah go-live." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="765" width="1360" height="46" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
