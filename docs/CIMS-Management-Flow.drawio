          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="&lt;b&gt;No&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;alasan wajib → kembali &lt;b&gt;In Progress&lt;/b&gt;; Civil perbaiki dan terbitkan ulang (ronde baru)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff4e6;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
