        <mxCell id="c4" value="&lt;b&gt;Kapan:&lt;/b&gt; Civil selesai Feasibility, BOQ, dan Drawing, lalu klik Send to Management. Status request = Management Approval." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
