        </mxCell>
        <mxCell id="c24" value="Keputusan&lt;br&gt;GM / Director" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffd966;strokeColor=#7f6000;strokeWidth=3;" vertex="1" parent="1">
