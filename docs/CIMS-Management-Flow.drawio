        <mxCell id="c21" value="3. BAPP (approval akhir)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#7f6000;strokeColor=#7f6000;fontColor=#ffffff;" vertex="1" parent="1">
