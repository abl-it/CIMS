        <mxCell id="c22" value="&lt;b&gt;Kapan:&lt;/b&gt; semua action plan 100%, BAPP diterbitkan Civil, dan sudah di-Accept Kabag → FAT → DGO (ABL)." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
